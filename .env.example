# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=A.B SaX AI
NEXT_PUBLIC_DEMO_MODE=true

# Backend Environment Variables
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/absax_ai
SESSION_SECRET=your_secret_key_here_change_in_production
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# AI Provider Configuration
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4-turbo
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# Search Provider Configuration
SEARCH_PROVIDER=bing
SEARCH_API_KEY=

# Image Provider Configuration
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_MODEL=dall-e-3

# Video Provider Configuration
VIDEO_PROVIDER=none
VIDEO_API_KEY=

# File Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=./uploads
MAX_FILE_SIZE=52428800
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Demo Mode
DEMO_MODE=true
DEMO_PAYMENT_ENABLED=true

# Subscription Configuration
FREE_QUESTION_LIMIT=5
DAILY_PRICE=1000
WEEKLY_PRICE=7000
MONTHLY_PRICE=30000
YEARLY_PRICE=100000
VIDEO_CREDIT_COST=100
IMAGE_CREDIT_COST=10

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@absaxai.com

# Logging
LOG_LEVEL=info
